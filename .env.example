# Supabase
SUPABASE_URL=https://rpthzrditbbrhtmuttmx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_DN2bLAFsWSj0WHDqfD-FuQ_gAdGKXSi
SUPABASE_SERVICE_ROLE_KEY=      # Settings → API → service_role (never commit this)

# Crelio tokens — one per centre (never commit these)
CRELIO_TOKEN_KYL=               # Kalyan Nagar   labId 9488
CRELIO_TOKEN_JNR=               # Jayanagar      labId 11541
CRELIO_TOKEN_KKP=               # Kanakapura     labId 11807
CRELIO_TOKEN_BSK=               # Banashankari   labId 12143

# Patient portal — Supabase "Send SMS" auth hook (Auth → Hooks → Send SMS)
# Hook URL = https://<deployment>/api/auth/sms-hook
SEND_SMS_HOOK_SECRET=           # the "v1,whsec_…" secret from the hook config

# Fyno (OTP SMS delivery). Endpoint: https://api.fyno.io/v1/<WSID>/event
# WSID + API key are both on Fyno → API Keys. Leave FYNO_WSID/KEY unset to log
# OTPs to the server console in dev (no SMS sent).
FYNO_WSID=                      # workspace id, e.g. FYAPA54901523IN
FYNO_API_KEY=
FYNO_OTP_EVENT=SigninOTP        # the Fyno notification event to fire
# FYNO_API_BASE=https://api.fyno.io   # override only for a non-default host

# Radiology scribe integration (RIS handoff). Shared HMAC secret used to sign the
# handoff token here and verify it on push-back (only this backend needs it).
RIS_HANDOFF_SECRET=            # any strong random string (openssl rand -hex 32)
SCRIBE_URL=https://radiologyscribe.cadabamsmindtalk.com

# Server
PORT=3000
